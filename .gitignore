/target
**/*.iroh.key

# Build outputs (D9/D17a): regenerated by `just packages`, which `gate` and
# `build-release` depend on. The AOT-compiled .afb IS the shipped artifact;
# neither it nor the extracted wasm belongs in source control.
packages/**/.build/
packages/**/*.afb
# The fiber package is its own cargo tree, so the root-only `/target` rule
# above does not reach it.
packages/**/target/
